{
  "name": "Flutter Codespace",
  "image": "ghcr.io/cirruslabs/flutter:stable",

  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter"
      ]
    }
  },

  "forwardPorts": [3000],

  "portsAttributes": {
    "3000": {
      "label": "Flutter Web",
      "onAutoForward": "openBrowser"
    }
  },

  "postCreateCommand": "flutter pub get",

  "postAttachCommand": "pgrep -f 'flutter run -d web-server' >/dev/null || flutter run -d web-server --web-hostname=0.0.0.0 --web-port=3000",

  "remoteUser": "root"
}